# Скопируйте в .env и при необходимости измените значения.
# Без EMAIL_HOST_USER / EMAIL_HOST_PASSWORD письма идут в консоль (Django console backend).
# На сервере задайте переменные окружения (systemd Environment= / export) — то же API.

# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=1

# Абсолютные ссылки (активация аккаунта). Локально можно оставить пустым в DEBUG.
# На демо-VPS: PUBLIC_HOST=195.19.209.121
PUBLIC_HOST=
PUBLIC_SCHEME=http
USE_HTTPS=0

# Email / SMTP (Gmail: нужен App Password при включённой 2FA)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
