# Скопируйте в .env и при необходимости измените значения.
# Без EMAIL_HOST_USER / EMAIL_HOST_PASSWORD письма идут в консоль (Django console backend).

# DJANGO_SECRET_KEY=
# Локально можно DJANGO_DEBUG=1. На демо-VPS: DJANGO_DEBUG=0 и DEMO_MODE=1
DJANGO_DEBUG=1
DEMO_MODE=0

# Абсолютные ссылки (активация аккаунта). На демо-VPS: PUBLIC_HOST=195.19.209.121
PUBLIC_HOST=
PUBLIC_SCHEME=http
USE_HTTPS=0
# EXTRA_ALLOWED_HOSTS=example.com,www.example.com

# Email / SMTP (Gmail: нужен App Password при включённой 2FA)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
